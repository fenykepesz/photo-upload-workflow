# Real data files — keep these local, never commit
upload_queue.csv
config.json
da_data.json

# Temporary local photo files used during upload
temp/

# Persistent image cache — survives re-runs, never committed
image_cache/

# macOS
.DS_Store

# Windows
Thumbs.db

# IDE / editor
.claude/
*.code-workspace

# Playwright browser profile (contains login cookies)
chrome-profile/

# Error screenshots from upload.py
error_*.png

# Python virtual environments and bytecode — platform-specific, never sync
.venv/
venv/
__pycache__/
*.pyc

# Mac filesystem artifacts (synced via OneDrive)
.fuse_hidden*
.DS_Store
*.code-workspace1*

# Old / test files
test_queue.csv
upload_queue_old.csv

# Cookies exported from browser (contain live session tokens — never commit)
fb_cookies.json
x_cookies.json
VK_data.json
*_cookies.json

# Log files from upload runs
*.log

# Backup files
*.bak
*.bak2

# VPS-only wrapper/integration scripts — deliberately never committed
run_upload.sh
run_login.sh
run_nosubmit.sh
erikrozman_publish.py
restart_vnc.sh

# Server-only backend (Tailscale-bound Flask app) — deliberately never
# committed to this public repo; covered by the private hermes-config-backup
# repo instead.
queue_server.py

# Runtime artifacts / caches — regenerated, never meaningful to diff
image_cache_stats.json
hermes_version_cache.json
infra_update_cache.json
upload_queue.csv.lock
logs/

# Old manual backup files, predates the ~/.hermes-manual-backups/ convention
upload.py.main-backup
upload.py.pre-reliability-merge-*
